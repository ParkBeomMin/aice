{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aice-content-factory.local/schemas/public-question-card-links.schema.json",
  "title": "공개 문항 ↔ 개념 카드 연결 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "links"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "links": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "card_ids"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^q[0-9]{2}$"
          },
          "card_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
            },
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true
          }
        }
      }
    }
  }
}
