{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aice-content-factory.local/schemas/public-cards-index.schema.json",
  "title": "공개 개념 카드 목록 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "decks",
    "question_links"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "mode": {
      "enum": [
        "preview",
        "production"
      ]
    },
    "decks": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deck_id",
          "revision",
          "title",
          "summary",
          "card_count",
          "file",
          "sha256",
          "publication_status"
        ],
        "properties": {
          "deck_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40,
            "pattern": "^[^—·<>]*$"
          },
          "summary": {
            "type": "string",
            "minLength": 4,
            "maxLength": 120,
            "pattern": "^[^—·<>]*$"
          },
          "card_count": {
            "type": "integer",
            "minimum": 1
          },
          "file": {
            "type": "string",
            "pattern": "^decks/[a-z0-9][a-z0-9-]{2,63}\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "publication_status": {
            "enum": [
              "draft",
              "approved"
            ]
          }
        }
      }
    },
    "question_links": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pack_id",
          "file",
          "sha256"
        ],
        "properties": {
          "pack_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "file": {
            "type": "string",
            "pattern": "^question-links/[a-z0-9][a-z0-9-]{2,63}\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
