{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aice-content-factory.local/schemas/public-card-deck.schema.json",
  "title": "공개 개념 카드 덱 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deck_id",
    "revision",
    "title",
    "summary",
    "intro_md",
    "learning_objectives",
    "seo",
    "tags",
    "publication_status",
    "license",
    "cards"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "deck_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40,
      "pattern": "^[^—·<>]*$"
    },
    "summary": {
      "type": "string",
      "minLength": 4,
      "maxLength": 120,
      "pattern": "^[^—·<>]*$"
    },
    "intro_md": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000,
      "pattern": "^[^—·<>]*$"
    },
    "learning_objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 120,
        "pattern": "^[^—·<>]*$"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 70,
          "pattern": "^[^—·<>]*$"
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 160,
          "pattern": "^[^—·<>]*$"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$"
      },
      "maxItems": 8
    },
    "publication_status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "license": {
      "type": "string",
      "maxLength": 80
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card_id",
          "revision",
          "front",
          "back",
          "code_example",
          "code_language",
          "code_runtime",
          "tags",
          "difficulty",
          "content_digest"
        ],
        "properties": {
          "card_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "front": {
            "type": "string",
            "minLength": 4,
            "maxLength": 120,
            "pattern": "^[^—·<>]*$"
          },
          "back": {
            "type": "string",
            "minLength": 4,
            "maxLength": 400,
            "pattern": "^[^—·<>]*$"
          },
          "code_example": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 600,
            "pattern": "^[^—·]*$"
          },
          "code_language": {
            "enum": [
              "python",
              "text"
            ]
          },
          "code_runtime": {
            "enum": [
              "reference_only",
              "pyodide",
              "external_only"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$"
            },
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true
          },
          "difficulty": {
            "enum": [
              "basic",
              "intermediate",
              "advanced"
            ]
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          }
        }
      }
    }
  }
}
