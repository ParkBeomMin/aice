{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aice-content-factory.local/content/public-question.schema.json",
  "title": "Public question",
  "description": "공개 사이트용 문항 (allowlist 필드만)",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "question_id": {
      "type": "string",
      "pattern": "^q[0-9]{2}$"
    },
    "public_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}-q[0-9]{2}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "starter_code": {
      "type": "string"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "pyodide",
            "external"
          ]
        },
        "max_execution_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "type",
        "max_execution_ms",
        "packages"
      ],
      "additionalProperties": false
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dataset_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
          },
          "url_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "license": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "dataset_id",
          "url_path",
          "sha256",
          "size_bytes",
          "license"
        ],
        "additionalProperties": false
      }
    },
    "grading": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "result_assertions",
            "self_check",
            "none"
          ]
        },
        "profile": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
        }
      },
      "required": [
        "type",
        "profile"
      ],
      "additionalProperties": false
    },
    "explanation": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "body_md": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available",
        "body_md"
      ],
      "additionalProperties": false
    },
    "answer": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available",
        "code"
      ],
      "additionalProperties": false
    },
    "video": {
      "type": "object",
      "properties": {
        "youtube_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]{11}$"
        },
        "start_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "youtube_id",
        "start_seconds"
      ],
      "additionalProperties": false
    },
    "publication_status": {
      "type": "string",
      "enum": [
        "draft",
        "approved"
      ]
    }
  },
  "required": [
    "schema_version",
    "pack_id",
    "question_id",
    "public_id",
    "revision",
    "title",
    "topic",
    "difficulty",
    "prompt",
    "starter_code",
    "runtime",
    "datasets",
    "grading",
    "explanation",
    "answer",
    "video",
    "publication_status"
  ],
  "additionalProperties": false
}