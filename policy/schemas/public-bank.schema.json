{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aice-content-factory.local/content/public-bank.schema.json",
  "title": "Public bank index",
  "description": "공개 문제은행 전체 목록",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "mode": {
      "type": "string",
      "enum": [
        "preview",
        "production"
      ]
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pack_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "question_count": {
            "type": "integer",
            "minimum": 1
          },
          "mock": {
            "type": "boolean"
          },
          "manifest_file": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "pack_id",
          "title",
          "summary",
          "question_count",
          "mock",
          "manifest_file",
          "manifest_sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "mode",
    "packs"
  ],
  "additionalProperties": false
}