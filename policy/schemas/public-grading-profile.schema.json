{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aice-content-factory.local/content/public-grading-profile.schema.json",
  "title": "Public grading bundle",
  "description": "공개 채점 규칙 묶음 (팩당 1개, public/content/<pack>/grading/<pack>-grading-<sha12>.json). 브라우저 사용자가 볼 수 있음을 전제로 함 (정답 코드는 없음, 기대 결과값은 포함). 사람이 검토·테스트한 프로필만 포함 · 1.1.0: 검사 label 필수 · 1.2.0(엔진 1.1.0): 학생 상태 기반 독립 재계산 probe (이전 계약 파일 보존) · 1.3.0(엔진 1.2.0): frame_unchanged | 1.4.0(엔진 1.3.0): 회귀 모델, rmse, selected_predictions, group_metric, imputed_against | 1.5.0(엔진 1.4.0): split_reproduced (분할 독립 재계산 비교), constrained_selection (제약 조건 분류 후보 선택), 후보별 threshold, alpha 와 min_samples_leaf 파라미터 | 1.6.0(엔진 1.5.0): figure_info, column_values, onehot_reproduced, confusion_matrix, metric_gap | 1.7.0(엔진 1.6.0): figure_data_match (히스토그램 구간 경계와 빈도, 산점도 x-y 쌍 전체), scaled_with (스케일러 transform 결과 비교) | 1.8.0(엔진 1.7.0): cost_selection, figure_data_match bar, time_split_reproduced, subset_metric, transformer_check, transformed_with, stratified_cv_scores, confusion_matrix cell | 1.9.0(엔진 1.8.0): preprocess_reproduced (원본 분할에서 결측 대체, 파생, 원-핫, 정렬을 다시 계산해 전체 값 비교), scaler_fitted_on (스케일러 통계가 지정 데이터와 같은지)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "engine_version",
    "grading_version",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.9.0"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "engine_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "grading_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}-g[0-9a-f]{12}$"
    },
    "questions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^q[0-9]{2}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "probe": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "var_type",
            "df_shape",
            "length",
            "columns",
            "null_count",
            "column_stat",
            "non_numeric_columns",
            "cell_result",
            "output_numbers",
            "output_text",
            "frames",
            "value",
            "is_fitted",
            "class_name",
            "attr_number",
            "metric",
            "imputed_values",
            "figure_count",
            "bar_count",
            "predictions",
            "probabilities",
            "refit_predictions",
            "model_params",
            "best_model",
            "series_index",
            "imputation_from_source",
            "frame_unchanged",
            "selected_predictions",
            "group_metric",
            "imputed_against",
            "split_reproduced",
            "constrained_selection",
            "figure_info",
            "column_values",
            "onehot_reproduced",
            "confusion_matrix",
            "metric_gap",
            "figure_data_match",
            "scaled_with",
            "cost_selection",
            "time_split_reproduced",
            "subset_metric",
            "transformer_check",
            "transformed_with",
            "stratified_cv_scores",
            "preprocess_reproduced",
            "scaler_fitted_on"
          ]
        },
        "var": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "X": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "y": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "column": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "exclude_columns": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          },
          "maxItems": 200
        },
        "stat": {
          "type": "string",
          "enum": [
            "mean",
            "median",
            "sum",
            "min",
            "max",
            "std",
            "nunique",
            "count"
          ]
        },
        "metric": {
          "type": "string",
          "enum": [
            "accuracy",
            "f1",
            "mae",
            "mse",
            "precision",
            "r2",
            "recall",
            "rmse"
          ]
        },
        "attr": {
          "type": "string",
          "enum": [
            "n_samples_seen_",
            "n_features_in_",
            "n_estimators",
            "max_iter"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "X_train": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "y_train": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "X_eval": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "model_class": {
          "type": "string",
          "enum": [
            "LogisticRegression",
            "RandomForestClassifier",
            "LinearRegression",
            "Ridge",
            "RandomForestRegressor",
            "DecisionTreeRegressor"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_iter": {
              "type": "number"
            },
            "random_state": {
              "type": "number"
            },
            "n_estimators": {
              "type": "number"
            },
            "n_jobs": {
              "type": "number"
            },
            "C": {
              "type": "number"
            },
            "max_depth": {
              "type": "number"
            },
            "alpha": {
              "type": "number"
            },
            "min_samples_leaf": {
              "type": "number"
            }
          }
        },
        "keys": {
          "type": "array",
          "items": {
            "enum": [
              "max_iter",
              "random_state",
              "n_estimators",
              "n_jobs",
              "C",
              "max_depth",
              "alpha",
              "min_samples_leaf"
            ]
          },
          "uniqueItems": true,
          "maxItems": 8
        },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "model",
              "X"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,40}$"
              },
              "model": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
              },
              "X": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
              },
              "threshold": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              }
            }
          }
        },
        "tie": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,40}$"
        },
        "except_columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true,
          "maxItems": 50
        },
        "frame": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "raw": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "stat_var": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "reduce": {
          "enum": [
            "argmax",
            "argmin"
          ]
        },
        "goal": {
          "enum": [
            "min",
            "max"
          ]
        },
        "select_metric": {
          "enum": [
            "accuracy",
            "f1",
            "mae",
            "mse",
            "precision",
            "r2",
            "recall",
            "rmse"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "drop": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 20
        },
        "test_size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "random_state": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "stratify": {
          "type": "boolean"
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "X_train": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "X_test": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "y_train": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "y_test": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "train": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "test": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            }
          }
        },
        "constraint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric",
            "op",
            "value"
          ],
          "properties": {
            "metric": {
              "type": "string",
              "enum": [
                "accuracy",
                "f1",
                "precision",
                "recall"
              ]
            },
            "op": {
              "enum": [
                "ge"
              ]
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric",
            "goal"
          ],
          "properties": {
            "metric": {
              "type": "string",
              "enum": [
                "accuracy",
                "f1",
                "precision",
                "recall"
              ]
            },
            "goal": {
              "enum": [
                "max",
                "min"
              ]
            }
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric",
            "goal"
          ],
          "properties": {
            "metric": {
              "type": "string",
              "enum": [
                "accuracy",
                "f1",
                "precision",
                "recall"
              ]
            },
            "goal": {
              "enum": [
                "max",
                "min"
              ]
            }
          }
        },
        "output": {
          "enum": [
            "selected",
            "scores",
            "match",
            "train_period",
            "test_period"
          ]
        },
        "field": {
          "enum": [
            "axes",
            "xlabel",
            "ylabel",
            "bars",
            "points",
            "bar_total",
            "x_mean",
            "y_mean"
          ]
        },
        "minus_column": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "as_list": {
          "type": "boolean"
        },
        "onehot_columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 10
        },
        "assign": {
          "type": "object",
          "maxProperties": 3,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          }
        },
        "pred": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "X_a": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "y_a": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "X_b": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "y_b": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "plot": {
          "enum": [
            "histogram",
            "scatter",
            "bar"
          ]
        },
        "bins": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "x_column": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "y_column": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scaler": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "scale_columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 50
        },
        "costs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fp",
            "fn"
          ],
          "properties": {
            "fp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "fn": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "series": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "check_labels": {
          "type": "boolean"
        },
        "date_column": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cutoff": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "where": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "column",
            "op",
            "value"
          ],
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "op": {
              "enum": [
                "ge"
              ]
            },
            "value": {
              "type": "number"
            }
          }
        },
        "transformer": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "n_splits": {
          "type": "integer",
          "minimum": 2,
          "maximum": 5
        },
        "shuffle": {
          "type": "boolean"
        },
        "scoring": {
          "enum": [
            "f1"
          ]
        },
        "cell": {
          "enum": [
            "tn",
            "fp",
            "fn",
            "tp"
          ]
        },
        "train_raw": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "test_raw": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "impute": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "columns",
            "stat"
          ],
          "properties": {
            "columns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "minItems": 1,
              "maxItems": 10,
              "uniqueItems": true
            },
            "stat": {
              "enum": [
                "median",
                "mean"
              ]
            }
          }
        },
        "ratios": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "num",
              "den"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "num": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "den": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "den_add": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              }
            }
          }
        },
        "abs_diffs": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "column",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "column": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "value": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "expect": {
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "eq",
            "approx",
            "in_range",
            "contains_all",
            "excludes_all",
            "set_eq",
            "approx_contains",
            "any_approx",
            "text_contains_all",
            "truthy"
          ]
        },
        "value": {},
        "ref_probe": {
          "$ref": "#/$defs/probe"
        },
        "abs_tol": {
          "type": "number",
          "minimum": 0
        },
        "rel_tol": {
          "type": "number",
          "minimum": 0
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "probe",
        "expect",
        "weight",
        "feedback",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
        },
        "probe": {
          "$ref": "#/$defs/probe"
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "feedback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "profile",
        "profile_revision",
        "review_status",
        "depends_on",
        "points",
        "checks"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^q[0-9]{2}$"
        },
        "profile": {
          "type": "string"
        },
        "profile_revision": {
          "type": "integer",
          "minimum": 1
        },
        "review_status": {
          "enum": [
            "tested",
            "approved"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^q[0-9]{2}$"
          },
          "uniqueItems": true
        },
        "points": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    }
  }
}
