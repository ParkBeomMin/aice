    "q06": {
      "question_id": "q06",
      "profile": "associate-v1",
      "profile_revision": 3,
      "review_status": "approved",
      "depends_on": [
        "q01"
      ],
      "points": 1,
      "checks": [
        {
          "id": "no-null",
          "label": "quiz_avg_score 결측 없음",
          "probe": {
            "kind": "null_count",
            "var": "df_clean",
            "column": "quiz_avg_score"
          },
          "expect": {
            "op": "eq",
            "value": 0
          },
          "weight": 1,
          "feedback": "df_clean 의 quiz_avg_score 에 결측이 남아 있습니다."
        },
        {
          "id": "median-fill",
          "label": "결측 위치마다 원본 중앙값으로 대체",
          "probe": {
            "kind": "imputation_from_source",
            "var": "df_clean",
            "source": "df_raw",
            "column": "quiz_avg_score",
            "stat": "median"
          },
          "expect": {
            "op": "approx",
            "value": {
              "filled_dev": 0,
              "kept_dev": 0,
              "same_rows": true
            },
            "abs_tol": 1e-09,
            "rel_tol": 0
          },
          "weight": 3,
          "feedback": "원래 결측이었던 위치를 원본 관측 중앙값으로 채우고, 나머지 값과 행은 그대로 두세요."
        },
        {
          "id": "original-kept",
          "label": "원본 df_raw 그대로",
          "probe": {
            "kind": "frame_unchanged",
            "var": "df_raw",
            "source": "df_raw"
          },
          "expect": {
            "op": "eq",
            "value": {
              "same_rows": true,
              "same_columns": true,
              "changed_columns": []
            }
          },
          "weight": 1,
          "feedback": "원본 df_raw 가 바뀌었습니다. copy() 한 df_clean 에서만 처리하세요."
        },
        {
          "id": "others-kept",
          "label": "다른 컬럼과 행 보존",
          "probe": {
            "kind": "frame_unchanged",
            "var": "df_clean",
            "source": "df_raw",
            "except_columns": [
              "quiz_avg_score"
            ]
          },
          "expect": {
            "op": "eq",
            "value": {
              "same_rows": true,
              "same_columns": true,
              "changed_columns": []
            }
          },
          "weight": 1,
          "feedback": "quiz_avg_score 외의 컬럼, 행, 순서를 바꾸지 마세요."
        }
      ]
    },
