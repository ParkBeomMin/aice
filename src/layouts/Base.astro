---
import '../styles/global.css';
import { withBase } from '../lib/paths';
import { isProduction } from '../lib/content';
import { cardsEnabled } from '../lib/cards';
import { adsAllowed, ADSENSE_CLIENT, GA_ID, type PageKind } from '../lib/site';

interface Props { title: string; description: string; crumbs?: { label: string; href?: string }[]; wide?: boolean; kind?: PageKind; noindex?: boolean }
const { title, description, crumbs = [], wide = false, kind = 'policy', noindex = false } = Astro.props;
const ads = adsAllowed(kind);
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const fullTitle = title === 'AICE 실전 모의고사' ? title : `${title} | AICE 실전 모의고사`;
// 상단 메뉴 현재 위치 (모의고사, 개념 카드, 이용 안내)
const path = Astro.url.pathname;
const section = path.startsWith(withBase('exams/')) ? 'exams' : path.startsWith(withBase('cards/')) ? 'cards' : path.startsWith(withBase('guide/')) ? 'guide' : '';
const navItems = [
  { key: 'exams', href: withBase('exams/'), label: '모의고사', icon: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>' },
  ...(cardsEnabled() ? [{ key: 'cards', href: withBase('cards/'), label: '개념 카드', icon: '<rect x="3" y="6" width="14" height="14" rx="2"/><path d="M7 2h12a2 2 0 0 1 2 2v12"/>' }] : []),
  { key: 'guide', href: withBase('guide/'), label: '이용 안내', icon: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>' },
];
---
<!doctype html>
<html lang="ko" data-acf-debug={isProduction ? undefined : "1"} data-page-kind={kind} data-ads={ads ? '1' : '0'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(!isProduction || noindex) && <meta name="robots" content="noindex, nofollow" />}
    {ads && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>}
    {GA_ID && <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>}
    {GA_ID && <script is:inline define:vars={{ gaId: GA_ID, kind }}>window.dataLayer = window.dataLayer || []; function gtag(){ dataLayer.push(arguments); } window.gtag = gtag; gtag('js', new Date()); gtag('config', gaId, { page_kind: kind, allow_google_signals: false, allow_ad_personalization_signals: false });</script>}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="sitemap" href={withBase('sitemap.xml')} />
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    {!isProduction && (
      <div class="preview-banner" role="note">미리보기 빌드입니다. 합성(MOCK) 데이터이며 검색엔진에 노출되지 않습니다.</div>
    )}
    <header class="site-header">
      <div class:list={[wide ? "wrap-wide" : "wrap", "site-header-inner"]}>
        <a class="brand" href={withBase()} aria-label="AICE 실전 모의고사 홈">
          <span class="brand-mark" aria-hidden="true">AI</span>
          <span class="brand-text">AICE <span>실전 모의고사</span></span>
        </a>
        <nav class="site-nav" aria-label="주요 메뉴">
          {navItems.map((n) => (
            <a href={n.href} class:list={[{ 'is-active': section === n.key }]} aria-current={section === n.key ? (path === n.href ? 'page' : 'true') : undefined}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={n.icon} />
              <span>{n.label}</span>
            </a>
          ))}
        </nav>
      </div>
    </header>
    {crumbs.length > 0 && (
      <nav class:list={["crumbs", wide ? "wrap-wide" : "wrap"]} aria-label="현재 위치">
        <ol>
          <li><a href={withBase()}>홈</a></li>
          {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
        </ol>
      </nav>
    )}
    <main id="main" class:list={[wide ? "wrap-wide" : "wrap"]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class:list={[wide ? "wrap-wide" : "wrap", "footer-inner"]}>
        <div class="footer-top">
          <div class="footer-about">
            <a class="brand footer-brand" href={withBase()} aria-label="AICE 실전 모의고사 홈">
              <span class="brand-mark" aria-hidden="true">AI</span>
              <span class="brand-text">AICE <span>실전 모의고사</span></span>
            </a>
            <p>브라우저에서 바로 풀고 자동 채점까지 받는 AICE Associate 무료 실전 모의고사예요.</p>
          </div>
          <nav class="footer-cols" aria-label="사이트 링크">
            <div>
              <h2>학습</h2>
              <ul>
                <li><a href={withBase('exams/')}>모의고사</a></li>
                {cardsEnabled() && <li><a href={withBase('cards/')}>개념 카드</a></li>}
                <li><a href={withBase('guide/')}>이용 안내</a></li>
              </ul>
            </div>
            <div>
              <h2>사이트</h2>
              <ul>
                <li><a href={withBase('about/')}>소개</a></li>
                <li><a href={withBase('contact/')}>문의</a></li>
                <li><a href={withBase('privacy/')}>개인정보처리방침</a></li>
              </ul>
            </div>
          </nav>
        </div>
        <div class="footer-bottom">
          <p>직접 제작한 AICE Associate 대비 연습 문제입니다. 실제 시험 문항을 복제하지 않습니다.</p>
          <p>이 사이트는 AICE 시험 주관사와 관련이 없는 개인 학습 프로젝트입니다.</p>
          <p class="footer-copy">개념 카드와 데이터셋 <a href="https://creativecommons.org/licenses/by/4.0/deed.ko" rel="license noopener">CC BY 4.0</a> | <a href="https://github.com/ParkBeomMin/aice" rel="noopener">GitHub</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
