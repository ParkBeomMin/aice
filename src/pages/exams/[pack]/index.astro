---
import Base from '../../../layouts/Base.astro';
import { getManifests, DIFFICULTY_LABEL, topicLabel, formatBytes, type Manifest } from '../../../lib/content';
import { pageUrl, withBase } from '../../../lib/paths';

export function getStaticPaths() {
  return getManifests().map((m) => ({ params: { pack: m.pack_id }, props: { m } }));
}
const { m } = Astro.props as { m: Manifest };
const graded = new Set(m.grading?.question_ids ?? []);
const topics = [...new Set(m.questions.map((q) => topicLabel(q.topic)))];
---
<Base kind="pack" title={m.title} description={`${m.title}: ${m.question_count}문항, 제한시간 ${m.time_limit_minutes}분. ${m.summary}`}
      crumbs={[{ label: '모의고사', href: pageUrl('exams') }, { label: m.title }]}>
  <div class="ex">
    <header class="ab-hero ex-hero">
      <p class="ab-kicker">모의고사{m.mock ? ' (합성 MOCK)' : ''}</p>
      <h1>{m.title}</h1>
      <p>{m.summary}</p>
      <ul class="ab-stats" aria-label="회차 정보">
        <li><strong>{m.question_count}문항</strong><span>코딩 실습</span></li>
        <li><strong>{m.time_limit_minutes}분</strong><span>제한시간</span></li>
        <li><strong>{graded.size}문항</strong><span>자동 채점</span></li>
        <li><strong>{topics.length}개</strong><span>영역 ({topics.join(', ')})</span></li>
      </ul>
    </header>

    <section aria-labelledby="ex-modes">
      <h2 id="ex-modes">풀이 방법 고르기</h2>
      <div class="g-modes">
        <article class="g-mode g-mode-exam">
          <div class="g-mode-head"><span class="g-ic"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9 2h6"/></svg></span><div><span class="g-chip">추천</span><h3>실전 모드</h3></div></div>
          <p>{m.time_limit_minutes}분 타이머를 켜고 실제 시험처럼 풀어요. 제출하면 자동 채점 결과와 문항별 피드백을 보여줘요.</p>
          <a class="btn" href={pageUrl('exams', m.pack_id, 'exam')}>실전 모드 시작</a>
        </article>
        <article class="g-mode">
          <div class="g-mode-head"><span class="g-ic"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5M8 7h7"/></svg></span><div><span class="g-chip">시간 제한 없음</span><h3>연습 모드</h3></div></div>
          <p>셀 단위로 코드를 작성하고 실행하면서 천천히 풀어요. 원할 때 연습 채점을 받아볼 수 있어요.</p>
          <a class="btn btn-ghost" href={pageUrl('exams', m.pack_id, 'practice')}>노트북으로 풀기</a>
        </article>
      </div>
      <p class="ex-result-link"><a href={pageUrl('exams', m.pack_id, 'result')}>이전에 제출한 내 채점 결과 보기</a></p>
    </section>

    <section aria-labelledby="ex-qs">
      <h2 id="ex-qs">문항별 해설</h2>
      <p class="ex-sub">먼저 직접 풀어본 뒤 문항을 눌러 해설과 정답 코드를 확인하세요.</p>
      <ol class="ex-qs">
        {m.questions.map((q) => (
          <li>
            <a href={pageUrl('exams', m.pack_id, q.question_id)}>
              <span class="cd-no">{q.question_id.slice(1)}</span>
              <span class="ex-q-title">{q.title}</span>
              <span class="ex-q-meta"><span class="ex-topic">{topicLabel(q.topic)}</span><span class={`badge ${q.difficulty}`}>{DIFFICULTY_LABEL[q.difficulty]}</span></span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    {m.datasets.length > 0 && (
      <section aria-labelledby="ex-ds">
        <h2 id="ex-ds">데이터셋</h2>
        {m.datasets.map((d) => (
          <div class="ab-license ex-ds">
            <span class="g-ic"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg></span>
            <div>
              <strong>{d.url_path.split('/').pop()}</strong> <span class="ex-sub">({formatBytes(d.size_bytes)})</span>
              <p class="ab-sub">{d.license}</p>
            </div>
            <a class="btn btn-ghost btn-sm" href={withBase(d.url_path)} download>내려받기</a>
          </div>
        ))}
      </section>
    )}
  </div>
</Base>
