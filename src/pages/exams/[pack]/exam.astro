---
import Base from '../../../layouts/Base.astro';
import NotebookShell from '../../../components/NotebookShell.astro';
import { getManifests, type Manifest } from '../../../lib/content';
import { pageUrl } from '../../../lib/paths';
import { pageConfig, jsonForScript } from '../../../lib/page-config';

export function getStaticPaths() {
  return getManifests().map((m) => ({ params: { pack: m.pack_id }, props: { m } }));
}
const { m } = Astro.props as { m: Manifest };
const cfg = pageConfig(m);
---
<Base kind="exam" noindex title={`${m.title} 실전 모드`} description={`${m.title}: ${m.time_limit_minutes}분 실전 모드 (연습용 자동 채점)`}
      wide crumbs={[{ label: '모의고사', href: pageUrl('exams') }, { label: m.title, href: pageUrl('exams', m.pack_id) }, { label: '실전 모드' }]}>
  <section id="ex-screen" class="ex-screen" aria-live="polite">
    <h1>{m.title} 실전 모드</h1>
    <p id="ex-screen-msg">시험 상태를 확인하는 중…</p>
    <div id="ex-screen-actions" class="ex-actions"></div>
  </section>
  <div id="ex-bar" class="ex-bar" hidden>
    <span class="ex-timer" id="ex-timer" role="timer" aria-live="off">--:--</span>
    <span id="ex-timer-note" class="ex-timer-note">남음</span>
    <span id="ex-progress" class="ex-progress"></span>
    <button type="button" id="ex-submit" class="ex-submit">제출하고 채점</button>
  </div>
  <div id="ex-shell" hidden><NotebookShell m={m} mode="exam" /></div>
  <dialog id="ex-dialog" class="ex-dialog">
    <p id="ex-dialog-msg"></p>
    <div class="ex-actions"><button type="button" id="ex-dialog-cancel">취소</button> <button type="button" id="ex-dialog-ok" class="primary">확인</button></div>
  </dialog>
  <script type="application/json" id="acf-config" set:html={jsonForScript(cfg)}></script>
</Base>
<script>
  import { startExamApp } from '../../../scripts/exam-app.ts';
  void startExamApp();
</script>
