---
import Base from '../../../layouts/Base.astro';
import { getManifests, getQuestion, DIFFICULTY_LABEL, topicLabel, formatBytes, type Manifest, type PublicQuestion } from '../../../lib/content';
import { pageUrl, withBase } from '../../../lib/paths';
import { cardMap, questionLinks } from '../../../lib/cards';
import AdSlot from '../../../components/AdSlot.astro';


export function getStaticPaths() {
  return getManifests().flatMap((m) =>
    m.questions.map((mq, i) => ({
      params: { pack: m.pack_id, qid: mq.question_id },
      props: { m, q: getQuestion(m.pack_id, mq.question_id), prev: m.questions[i - 1]?.question_id, next: m.questions[i + 1]?.question_id },
    })),
  );
}
const { m, q, prev, next } = Astro.props as { m: Manifest; q: PublicQuestion; prev?: string; next?: string };
const label = `${q.question_id.toUpperCase()}. ${q.title}`;
const graded = !!m.grading?.question_ids.includes(q.question_id);
const cmap = cardMap();
const related = (questionLinks(m.pack_id)[q.question_id] ?? []).map((id) => cmap.get(id)).filter((x) => x !== undefined).slice(0, 3);
const desc = `${m.title} ${q.question_id.toUpperCase()}, ${topicLabel(q.topic)}, 난이도 ${DIFFICULTY_LABEL[q.difficulty]}. ${q.prompt.slice(0, 90)}`;
---
<Base kind="question" title={`${label} | ${m.title}`} description={desc}
      crumbs={[{ label: '모의고사', href: pageUrl('exams') }, { label: m.title, href: pageUrl('exams', m.pack_id) }, { label: q.question_id.toUpperCase() }]}>
  <article class="question" data-public-id={q.public_id} data-revision={q.revision}>
    <p class="meta">{topicLabel(q.topic)} | 난이도 <span class={`badge ${q.difficulty}`}>{DIFFICULTY_LABEL[q.difficulty]}</span> | r{q.revision} | <span class="grading-support" data-graded={graded ? '1' : '0'}>{graded ? '자동 채점 지원' : q.grading.type === 'self_check' || q.runtime.type === 'external' ? '자동 채점 미지원 (자기 점검)' : '자동 채점 미지원'}</span></p>
    <h1>{label}</h1>
    <div class="prompt">{q.prompt}</div>

    {q.datasets.length > 0 && (
      <section>
        <h2>데이터</h2>
        <ul>
          {q.datasets.map((d) => (
            <li><a href={withBase(d.url_path)} download>{d.url_path.split('/').pop()}</a> ({formatBytes(d.size_bytes)})</li>
          ))}
        </ul>
      </section>
    )}

    <section class="to-notebook" aria-label="노트북에서 풀기">
      <p>이 문제는 {m.title} 노트북의 {q.question_id.toUpperCase()} 셀에서 풀 수 있어요. 앞 문제에서 만든 변수(df 등)를 이어서 사용합니다.</p>
      <a class="btn" href={`${pageUrl('exams', m.pack_id, 'practice')}#${q.question_id}-prompt`}>노트북에서 이 문제 풀기</a>
    </section>

    <section aria-labelledby="exp-h">
      <h2 id="exp-h">해설</h2>
      {q.explanation.available || q.answer.available ? (
        <details>
          <summary>정답 코드와 해설 보기 (먼저 직접 풀어보세요)</summary>
          {q.answer.available && <pre class="code"><code>{q.answer.code}</code></pre>}
          {q.explanation.available && <div class="prompt">{q.explanation.body_md}</div>}
        </details>
      ) : (
        <p class="notice">해설 준비 중입니다.</p>
      )}
      {q.video.youtube_id && (
        <p><a href={`https://www.youtube.com/watch?v=${q.video.youtube_id}${q.video.start_seconds ? `&t=${q.video.start_seconds}s` : ''}`} rel="noopener">유튜브 해설 영상 보기</a></p>
      )}
    </section>

    {related.length > 0 && (
      <section class="rel-cards" aria-labelledby="rel-h">
        <h2 id="rel-h">관련 개념 카드</h2>
        <ul>
          {related.map((r) => (
            <li><a href={`${pageUrl('cards', r!.deck_id)}#${r!.card.card_id}`}><span class="rel-deck">{r!.deck_title}</span><span class="rel-q">{r!.card.front}</span></a></li>
          ))}
        </ul>
      </section>
    )}

    <AdSlot kind="question" unit="explanation" />

    <nav class="pager" aria-label="문항 이동">
      {prev ? <a href={pageUrl('exams', m.pack_id, prev)}>← {prev.toUpperCase()}</a> : <span />}
      <a href={pageUrl('exams', m.pack_id)}>목록</a>
      {next ? <a href={pageUrl('exams', m.pack_id, next)}>{next.toUpperCase()} →</a> : <span />}
    </nav>
  </article>
</Base>
