---
// 수동 배너 광고 (AdSense 반응형 디스플레이). 광고 허용 페이지에서만 렌더링. 버튼과 떨어진 위치에만 둔다.
import { adsAllowed, ADSENSE_CLIENT, AD_SLOTS, type PageKind } from '../lib/site';
interface Props { kind: PageKind; unit: keyof typeof AD_SLOTS }
const { kind, unit } = Astro.props;
const show = adsAllowed(kind);
---
{show && (
  <aside class="ad-slot" aria-label="광고">
    <p class="ad-label">광고</p>
    <ins class="adsbygoogle" style="display:block" data-ad-client={ADSENSE_CLIENT} data-ad-slot={AD_SLOTS[unit]} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
