    {
      "card_id": "pd-008",
      "revision": 1,
      "front": "groupby().mean()은 무엇을 하나?",
      "back": "그룹별 수치 컬럼의 평균을 계산한다.",
      "code_example": "means = df.groupby(\"tier\")[\"score\"].mean()",
      "code_language": "python",
